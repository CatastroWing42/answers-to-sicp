(define (c+ x y)
    (let ((z (make-connector)))
        (adder x y z)
        z))
(define (c* x y)
    (let ((z (make-connector)))
        (multiplier x y z)
        z))
(define (c/ x y)
    (let ((z (make-connector)))
        (multiplier z y x)
        z))
(define (cv x)
    (let ((z (make-connector)))
        (constant x z)
        z))
(define (celsius-fahrenheit-converter x)
    (c+ (c* (c/ (cv 9) (cv 5))
            x)
        (cv 32)))
(define celsius (make-connector))
(define fahrenheit (celsius-fahrenheit-converter celsius))
(probe 'celsius celsius)
(probe 'fahrenheit fahrenheit)
(set-value! celsius 10 'user)