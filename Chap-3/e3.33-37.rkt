; 3.35
(define (squarer a b)
    (define (square x)
        (* x x))
    (define (process-new-value)
        (if (has-value? b)
            (if (< (get-value b) 0)
                (error "square less than 0: SQUARER" (get-value b))
                (set-value! a
                    (sqrt (get-value b))
                    me))
            (if (has-value? a)
                (set-value! b (square (get-value a)) me))))
    (define (process-forget-value)
        (forget-value! a)
        (forget-value! b)
        (process-new-value))
    (define (me m)
        (cond
            ((eq? m 'value-set) process-new-value)
            ((eq? m 'value-forget) process-forget-value)
            (else (error "Invalid operation: SQUARER" m))))
    (connect a me)
    (connect b me)
    me)

(define squarer-a (make-connector))
(define squarer-b (make-connector))
(probe 'squarer-a squarer-a)
(probe 'squarer-b squarer-b)
(squarer squarer-a squarer-b)
(set-value! squarer-b 2 'user)

