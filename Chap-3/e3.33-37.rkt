(define (averager a b c)
    (let ((lc1 (make-connector))
            (lc2 (make-connector)))
        (constant 2 lc1)
        (multiplier lc1 c lc2)
        (adder a b lc2)))

(define C (make-connector))
(define A (make-connector))
(define B (make-connector))

(probe 'A A)
(probe 'B B)
(probe 'C C)
(averager A B C)

(set-value! C 1 'user)
(set-value! A 0 'user)

