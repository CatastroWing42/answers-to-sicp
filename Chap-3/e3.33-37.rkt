#lang sicp

(define (adder a1 a2 sum)
    (define (proc)
        (cond
            ((and (has-value? a1)
                    (has-value? a2))
                (set-value! sum
                    (+ (get-value a1) (get-value a2))
                    me))
            ((and (has-value? a1)
                    (has-value? sum))
                (set-value! a2
                    (- (get-value sum) (get-value a1))
                    me))
            ((and (has-value? a2)
                    (has-value? sum))
                (set-value! a1
                    (- (get-value sum) (get-value a2))
                    me))))
    (define (forget-proc)
        (forget-value! a1)
        (forget-value! a2)
        (forget-value! sum)
        (proc))
    (define (me m)
        (cond
            ((eq? m 'value-set) proc)
            ((eq? m 'value-forget) forget-proc)
            (else (error "Invalid operation: ADDER" m))))
    (connect a1 me)
    (connect a2 me)
    (connect sum me)
    me)

(define (multiplier m1 m2 product)
    (define (proc)
        (cond
            ((or (and (has-value? m1) (= (get-value m1) 0))
                (and (has-value? m2) (= (get-value m2) 0)))
                (set-value! product 0 me))
            ((and (has-value? m1) (has-value? m2))
                (set-value! product
                    (* (get-value m1) (get-value m2))
                    me))
            ((and (has-value? m1) (has-value? product))
                (set-value! m2
                    (/ (get-value product) (get-value m1))
                    me))
            ((and (has-value? m2) (has-value? product))
                (set-value! m1
                    (/ (get-value product) (get-value m2))
                    me))))
    (define (forget-proc)
        (forget-value! m1)
        (forget-value! m2)
        (forget-value! product)
        (proc))
    (define (me m)
        (cond
            ((eq? m 'value-set) proc)
            ((eq? m 'value-forget) forget-proc)
            (else (error "Invalid operation: MULTIPLIER" m))))
    (connect m1 me)
    (connect m2 me)
    (connect product me)
    me)

(define (constant c x)
    (define (me m)
        (error "Invalid operation: CONSTANT" m))
    (connect x me)
    (set-value! x c me)
    me)

(define (inform-about-value constraint)
    ((constraint 'value-set)))
(define (inform-about-no-value constraint)
    ((constraint 'value-forget)))

(define (make-connector)
    (let ((value false)
            (informant false)
            (constraints '()))
        (define (set-value-proc! new-value setter)
            (cond
                ((not (has-value? me))
                    (set! value new-value)
                    (set! informant setter)
                    (for-each-except setter
                        inform-about-value
                        constraints))
                ((not (= value new-value))
                    (error "Contradiction" (list value new-value)))))
        (define (forget-value-proc! retractor)
            (if (eq? retractor informant)
                (begin (set! informant false)
                    (for-each-except retractor
                        inform-about-no-value
                        constraints))))
        (define (connect-proc! new-constraint)
            (if (not (memq new-constraint constraints))
                (set! constraints
                    (cons new-constraint constraints)))
            (if (has-value? me)
                (inform-about-value new-constraint)))
        (define (me m)
            (cond
                ((eq? m 'has-value?)
                    (if informant true false))
                ((eq? m 'get-value) value)
                ((eq? m 'set-value!) set-value-proc!)
                ((eq? m 'forget-value!) forget-value-proc!)
                ((eq? m 'connect!) connect-proc!)
                (else (error "Invalid operation: MAKE-CONNECTOR" m))))
        me))

(define (has-value? connector)
    (connector 'has-value?))
(define (get-value connector)
    (connector 'get-value))
(define (set-value! connector value setter)
    ((connector 'set-value!) value setter))
(define (forget-value! connector retractor)
    ((connector 'forget-value!) retractor))
(define (connect connector constraint)
    ((connector 'connect!) constraint))

(define (probe name connector)
    (define (print-probe value)
        (newline) (display "Probe: ") (display name)
        (display " = ") (display value))
    (define (process-new-value)
        (print-probe (get-value connector)))
    (define (process-forget-value)
        (print-probe "?"))
    (define (me m)
        (cond
            ((eq? m 'value-set) process-new-value)
            ((eq? m 'value-forget) process-forget-value)
            (else (error "Invalid operation: PROBE" m))))
    (connect connector me)
    me)

(define (for-each-except except proc list)
    (define (loop sublist)
        (if (not (null? sublist))
            (if (eq? (car sublist) except)
                (loop (cdr sublist))
                (begin (proc (car sublist))
                    (loop (cdr sublist))))))
    (loop list))


